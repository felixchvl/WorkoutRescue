# Copy to receiver/.env (git-ignored) and fill in. Never commit the real token.
# Generate one with: python3 scripts/gen_token.py
WR_TOKEN=CHANGE-ME-USE-GEN-TOKEN
WR_HOST=127.0.0.1
WR_PORT=8787
WR_EXPORT_DIR=./exports
WR_MAX_BYTES=67108864
# Optional direct TLS (otherwise put an HTTPS reverse proxy / tunnel in front):
# WR_TLS_CERT=/path/fullchain.pem
# WR_TLS_KEY=/path/privkey.pem
# WR_LOG_FILE=./receiver.log
